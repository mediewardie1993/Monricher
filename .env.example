# Copy this file to .env.local for local development (git-ignored).
# On Vercel, set these under Project Settings -> Environment Variables instead.

# Free at console.groq.com — no card required. Powers the AI chatbot replies
# in app/api/chat/route.ts. Without this set, the chatbot still works using
# its built-in keyword-based responses (lib/chatbot-config.ts).
GROQ_API_KEY=
